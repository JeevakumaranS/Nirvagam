  sgstAmount          Decimal      @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount          Decimal      @default(0) @map("igst_amount") @db.Decimal(15, 2)
  vatAmount           Decimal      @default(0) @map("vat_amount") @db.Decimal(15, 2)
  landedCost          Decimal      @default(0) @map("landed_cost") @db.Decimal(15, 4)
  totalAmount         Decimal      @default(0) @map("total_amount") @db.Decimal(15, 2)
  batchNumber         String?      @map("batch_number")
  serialNumber        String?      @map("serial_number")
  expiryDate          DateTime?    @map("expiry_date")

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("purchase_invoice_items")
}

model PurchaseInvoiceCharge {
  id                String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purchaseInvoiceId String                   @map("purchase_invoice_id") @db.Uuid
  chargeType        PurchaseChargeType        @map("charge_type")
  name              String
  amount            Decimal                  @db.Decimal(15, 2)
  isTaxable         Boolean                  @default(false) @map("is_taxable")
  taxRate           Decimal                  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal                  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  allocationMethod  FreightAllocationMethod? @map("allocation_method")
  accountId         String?                  @map("account_id") @db.Uuid

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_charges")
}

model PurchaseReturn {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId        String               @map("business_id") @db.Uuid
  branchId          String               @map("branch_id") @db.Uuid
  supplierId        String               @map("supplier_id") @db.Uuid
  purchaseInvoiceId String               @map("purchase_invoice_id") @db.Uuid
  journalEntryId    String?              @map("journal_entry_id") @db.Uuid
  returnNumber       String               @map("return_number")
  returnDate         DateTime             @map("return_date")
  currencyCode       String               @default("INR") @map("currency_code")
  status             PurchaseReturnStatus @default(DRAFT)
  warehouseId        String               @map("warehouse_id") @db.Uuid
  taxableAmount      Decimal              @default(0) @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount         Decimal              @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount         Decimal              @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount         Decimal              @default(0) @map("igst_amount") @db.Decimal(15, 2)
  vatAmount          Decimal              @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalTax           Decimal              @default(0) @map("total_tax") @db.Decimal(15, 2)
  grandTotal         Decimal              @default(0) @map("grand_total") @db.Decimal(15, 2)
  calculationRule    Json                 @default("{}") @map("calculation_rule")
  taxSummary         Json                 @default("{}") @map("tax_summary")
  postedAt           DateTime?            @map("posted_at")
  cancelledAt        DateTime?            @map("cancelled_at")
  cancellationReason String?              @map("cancellation_reason")
  reason             String?
  createdById       String               @map("created_by") @db.Uuid
  updatedById       String?              @map("updated_by") @db.Uuid
  version           Int                  @default(1)
  isDeleted         Boolean              @default(false) @map("is_deleted")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  items    PurchaseReturnItem[]

  @@unique([branchId, returnNumber])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purchaseReturnId String  @map("purchase_return_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  itemName         String? @map("item_name")
  unit             String? @default("PCS")
  invoiceItemId    String? @map("invoice_item_id") @db.Uuid
  quantity         Decimal @db.Decimal(15, 3)
  unitRate         Decimal @map("unit_rate") @db.Decimal(15, 4)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxableValue     Decimal @default(0) @map("taxable_value") @db.Decimal(15, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  cgstAmount       Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount       Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount       Decimal @default(0) @map("igst_amount") @db.Decimal(15, 2)
  vatAmount        Decimal @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount      Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)

  purchaseReturn PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("purchase_return_items")
}

model PurchasePayment {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId        String                @map("business_id") @db.Uuid
  branchId          String                @map("branch_id") @db.Uuid
  supplierId        String                @map("supplier_id") @db.Uuid
  paymentNumber      String                @map("payment_number")
  paymentDate        DateTime              @map("payment_date")
  currencyCode       String                @default("INR") @map("currency_code")
  paymentType        PurchasePaymentType   @default(BILL_PAYMENT) @map("payment_type")
  mode               PaymentMode           @default(BANK_TRANSFER)
  amount             Decimal               @db.Decimal(15, 2)
  allocatedAmount    Decimal               @default(0) @map("allocated_amount") @db.Decimal(15, 2)
  unallocatedAmount  Decimal               @default(0) @map("unallocated_amount") @db.Decimal(15, 2)
  status             PurchasePaymentStatus @default(DRAFT)
  bankAccountId      String?               @map("bank_account_id") @db.Uuid
  journalEntryId     String?               @map("journal_entry_id") @db.Uuid
  reference          String?
  notes              String?
  cancelledAt        DateTime?             @map("cancelled_at")
  cancellationReason String?               @map("cancellation_reason")
  idempotencyKey     String?               @unique @map("idempotency_key")
  createdById       String                @map("created_by") @db.Uuid
  updatedById       String?               @map("updated_by") @db.Uuid
  version           Int                   @default(1)
  isDeleted         Boolean               @default(false) @map("is_deleted")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  branch      Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations PurchasePaymentAllocation[]

  @@unique([branchId, paymentNumber])
  @@map("purchase_payments")
}

model PurchasePaymentAllocation {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purchasePaymentId String  @map("purchase_payment_id") @db.Uuid
  purchaseInvoiceId String  @map("purchase_invoice_id") @db.Uuid
  amount            Decimal @db.Decimal(15, 2)

  purchasePayment PurchasePayment @relation(fields: [purchasePaymentId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  @@unique([purchasePaymentId, purchaseInvoiceId])
  @@map("purchase_payment_allocations")
}

model InAppNotification {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  title        String
  message      String
  documentType String?  @map("document_type")
  documentId   String?  @map("document_id") @db.Uuid
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("in_app_notifications")
}

model ApprovalRule {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  department   String?
  documentType String   @map("document_type")
  minAmount    Decimal  @default(0) @map("min_amount") @db.Decimal(15, 2)
  maxAmount    Decimal? @map("max_amount") @db.Decimal(15, 2)
  levels       Json
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([businessId, branchId, documentType, isActive])
  @@map("approval_rules")
}

model ApprovalRequest {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String                @map("business_id") @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  documentType  String                @map("document_type")
  documentId    String                @map("document_id") @db.Uuid
  ruleId        String?               @map("rule_id") @db.Uuid
  status        ApprovalRequestStatus @default(PENDING)
  currentLevel  Int                   @default(1) @map("current_level")
  requestedById String                @map("requested_by") @db.Uuid
  reason        String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  history ApprovalHistory[]

  @@index([businessId, branchId, documentType, status])
  @@map("approval_requests")
}

model ApprovalHistory {
  id                String   @id @default(dbgenerated("uuidv7()"))
  approvalRequestId String   @map("approval_request_id") @db.Uuid
  action            String
  actorId           String   @map("actor_id") @db.Uuid
  level             Int
  reason            String?
  delegatedToId     String?  @map("delegated_to") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@map("approval_history")
}

model PurchaseAttachment {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  documentType String   @map("document_type")
  documentId   String   @map("document_id") @db.Uuid
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  mimeType     String   @map("mime")
  size         Int
  checksum     String?
  uploadedById String   @map("uploaded_by") @db.Uuid
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([businessId, branchId, documentType, documentId])
  @@map("purchase_attachments")
}

model DocumentNumberSeries {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  documentType  String   @map("document_type")
  prefix        String
  currentNumber Int      @default(1) @map("current_number")
  padding       Int      @default(4)
  suffix        String?
  resetPeriod   String   @default("YEAR") @map("reset_period")
  resetYear     Int?     @map("reset_year")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([businessId, branchId, documentType])
  @@map("document_number_series")
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_DISBURSEMENT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  CREDIT
}

model Payment {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  type        PaymentType
  customerId  String?     @map("customer_id") @db.Uuid
  supplierId  String?     @map("supplier_id") @db.Uuid
  mode        PaymentMode @default(CASH)
  amount      Decimal     @db.Decimal(15, 2)
  paymentDate DateTime    @map("payment_date")
  reference   String?
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer?           @relation(fields: [customerId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId      String  @map("payment_id") @db.Uuid
  salesInvoiceId String? @map("sales_invoice_id") @db.Uuid
  amount         Decimal @db.Decimal(15, 2)

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])

  @@map("payment_allocations")
}

model Expense {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  category    String // Rent, Salary, Electricity, Fuel, etc.
  amount      Decimal     @db.Decimal(15, 2)
  expenseDate DateTime    @map("expense_date")
  paymentMode PaymentMode @default(CASH) @map("payment_mode")
  gstin       String?
  taxAmount   Decimal     @default(0) @map("tax_amount") @db.Decimal(15, 2)
  receiptUrl  String?     @map("receipt_url")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

// ----------------------------------------------------
// 8. System Audit Logs
// ----------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  businessId String?  @map("business_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // CREATE, UPDATE, DELETE, CANCEL, POST
  entityType String   @map("entity_type") // SalesInvoice, User, etc.
  entityId   String   @map("entity_id") @db.Uuid
  diff       Json? // before and after state
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
