datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Tenancy, Plans & Subscriptions
// ----------------------------------------------------

enum TenantStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlanTier {
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

model Tenant {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug        String       @unique
  name        String
  status      TenantStatus @default(TRIALING)
  trialEndsAt DateTime?    @map("trial_ends_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  businesses    Business[]
  users         User[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model Plan {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  tier         PlanTier @unique
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice  Decimal  @map("yearly_price") @db.Decimal(10, 2)
  maxUsers     Int      @map("max_users")
  maxBranches  Int      @map("max_branches")
  maxInvoices  Int      @map("max_invoices")
  features     Json     @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  planId    String       @map("plan_id") @db.Uuid
  status    TenantStatus @default(ACTIVE)
  startDate DateTime     @map("start_date")
  endDate   DateTime     @map("end_date")
  autoRenew Boolean      @default(true) @map("auto_renew")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// ----------------------------------------------------
// 2. Organization, Business & Branches
// ----------------------------------------------------

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  INDIVIDUAL
  OTHER
}

enum IndustryType {
  RETAIL
  WHOLESALE
  SUPERMARKET
  TEXTILE
  GROCERY
  ELECTRICAL
  HARDWARE
  MEDICAL
  RESTAURANT
  MANUFACTURING
  DISTRIBUTOR
  SERVICE
  TRADING
  OTHER
}

model Business {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  legalName      String       @map("legal_name")
  tradeName      String       @map("trade_name")
  businessType   BusinessType @default(PROPRIETORSHIP) @map("business_type")
  industry       IndustryType @default(RETAIL)
  pan            String?
  tan            String?
  cin            String?
  email          String?
  phone          String?
  website        String?
  logoUrl        String?      @map("logo_url")
  signatureUrl   String?      @map("signature_url")
  currency       String       @default("INR")
  addressLine1   String       @map("address_line1")
  addressLine2   String?      @map("address_line2")
  city           String
  state          String
  stateCode      String       @map("state_code")
  pincode        String
  country        String       @default("India")
  enabledModules Json         @default("[\"sales\", \"purchase\", \"inventory\", \"accounting\", \"pos\", \"gst\"]") @map("enabled_modules")
  taxSettings    Json         @default("{}") @map("tax_settings")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches          Branch[]
  gstRegistrations  GstRegistration[]
  fiscalPeriods     FiscalPeriod[]
  documentSequences DocumentSequence[]
  roles             Role[]
  taxRates          TaxRate[]
  units             Unit[]
  categories        Category[]
  brands            Brand[]
  products          Product[]
  customers         Customer[]
  suppliers         Supplier[]
  chartOfAccounts   ChartOfAccount[]
  journalEntries    JournalEntry[]
  auditLogs         AuditLog[]

  @@map("businesses")
}

model Branch {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  name         String
  code         String
  isHeadOffice Boolean  @default(false) @map("is_head_office")
  gstin        String?
  phone        String?
  email        String?
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  stateCode    String   @map("state_code")
  pincode      String
  ownerId      String?  @map("owner_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner            User?                  @relation("BranchOwner", fields: [ownerId], references: [id])
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses       Warehouse[]
  userAssignments  UserBranchAssignment[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  expenses         Expense[]
  payments         Payment[]

  @@unique([businessId, code])
  @@map("branches")
}

model GstRegistration {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  gstin      String   @unique
  legalName  String   @map("legal_name")
  state      String
  stateCode  String   @map("state_code")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("gst_registrations")
}

model FiscalPeriod {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String // e.g. "FY 2026-2027"
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  isLocked   Boolean  @default(false) @map("is_locked")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@map("fiscal_periods")
}

model DocumentSequence {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  documentType String   @map("document_type") // INVOICE, QUOTATION, ORDER, etc.
  prefix       String
  nextNumber   Int      @default(1) @map("next_number")
  padding      Int      @default(4)
  suffix       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, branchId, documentType])
  @@map("document_sequences")
}

// ----------------------------------------------------
// 3. Identity, Users, Roles & Permissions
// ----------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  team         String?  @map("team")
  designation  String?  @map("designation")
  memberType   String   @default("EMPLOYEE") @map("member_type")
  status       String   @default("ACTIVE") @map("status")
  joiningDate  DateTime? @default(now()) @map("joining_date")
  reportsToId  String?  @map("reports_to_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportsTo         User?                  @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates      User[]                 @relation("UserHierarchy")
  ownedBranches     Branch[]               @relation("BranchOwner")
  userRoles         UserRole[]
  branchAssignments UserBranchAssignment[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid // null for platform system roles
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resource    String // e.g. "sales_invoice", "accounting", "user"
  action      String // e.g. "view", "create", "edit", "delete", "approve", "cancel"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserBranchAssignment {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  isDefault Boolean @default(false) @map("is_default")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branch_assignments")
}

// ----------------------------------------------------
// 4. Master Data: Taxes, Units, Catalog & Partners
// ----------------------------------------------------

model TaxRate {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String // e.g. "GST 18%", "GST 5%", "Nil"
  rate       Decimal  @db.Decimal(5, 2) // e.g. 18.00
  cgstRate   Decimal  @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate   Decimal  @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  igstRate   Decimal  @default(0) @map("igst_rate") @db.Decimal(5, 2)
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("tax_rates")
}

model Unit {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  name          String // e.g. "Pieces", "Kilogram", "Box"
  symbol        String // e.g. "PCS", "KG", "BOX"
  decimalPlaces Int      @default(0) @map("decimal_places")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, symbol])
  @@map("units")
}

model Category {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  name       String
  slug       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([businessId, slug])
  @@map("categories")
}

model Brand {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@map("brands")
}

model Product {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  brandId        String?  @map("brand_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  taxRateId      String   @map("tax_rate_id") @db.Uuid
  name           String
  sku            String
  barcode        String?
  hsnCode        String?  @map("hsn_code")
  description    String?
  purchasePrice  Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 2)
  salesPrice     Decimal  @default(0) @map("sales_price") @db.Decimal(15, 2)
  mrp            Decimal  @default(0) @db.Decimal(15, 2)
  minStockLevel  Decimal  @default(0) @map("min_stock_level") @db.Decimal(15, 2)
  isTaxInclusive Boolean  @default(false) @map("is_tax_inclusive")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  unit     Unit             @relation(fields: [unitId], references: [id])
  taxRate  TaxRate          @relation(fields: [taxRateId], references: [id])
  variants ProductVariant[]

  @@unique([businessId, sku])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  name          String // e.g. "Standard", "Red - XL"
  sku           String   @unique
  barcode       String?
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(15, 2)
  salesPrice    Decimal  @map("sales_price") @db.Decimal(15, 2)
  mrp           Decimal  @db.Decimal(15, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  salesInvoiceItems    SalesInvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@map("product_variants")
}

model Customer {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  name              String
  companyName       String?  @map("company_name")
  email             String?
  phone             String
  gstin             String?
  pan               String?
  billingStreet     String   @map("billing_street")
  billingCity       String   @map("billing_city")
  billingState      String   @map("billing_state")
  billingStateCode  String   @map("billing_state_code")
  billingPincode    String   @map("billing_pincode")
  shippingStreet    String?  @map("shipping_street")
  shippingCity      String?  @map("shipping_city")
  shippingState     String?  @map("shipping_state")
  shippingStateCode String?  @map("shipping_state_code")
  shippingPincode   String?  @map("shipping_pincode")
  creditLimit       Decimal  @default(0) @map("credit_limit") @db.Decimal(15, 2)
  creditPeriodDays  Int      @default(30) @map("credit_period_days")
  openingBalance    Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  payments      Payment[]

  @@map("customers")
}

model Supplier {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  name             String
  companyName      String?  @map("company_name")
  email            String?
  phone            String
  gstin            String?
  pan              String?
  addressStreet    String   @map("address_street")
  city             String
  state            String
  stateCode        String   @map("state_code")
  pincode          String
  creditPeriodDays Int      @default(30) @map("credit_period_days")
  openingBalance   Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]
  payments         Payment[]

  @@map("suppliers")
}

// ----------------------------------------------------
// 5. Inventory & Warehouses
// ----------------------------------------------------

model Warehouse {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  code      String
  isDefault Boolean  @default(false) @map("is_default")
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@unique([branchId, code])
  @@map("warehouses")
}

model StockBalance {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(15, 2)
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(15, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@map("stock_balances")
}

enum StockMovementType {
  IN_PURCHASE
  OUT_SALE
  IN_TRANSFER
  OUT_TRANSFER
  ADJUSTMENT_ADD
  ADJUSTMENT_SUB
  RETURN_IN_CREDIT_NOTE
  RETURN_OUT_DEBIT_NOTE
}

model StockMovement {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  type        StockMovementType
  quantity    Decimal           @db.Decimal(15, 2)
  unitCost    Decimal           @map("unit_cost") @db.Decimal(15, 2)
  totalCost   Decimal           @map("total_cost") @db.Decimal(15, 2)
  referenceId String?           @map("reference_id") @db.Uuid // Invoice/Bill ID
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

// ----------------------------------------------------
// 6. Double-Entry Accounting
// ----------------------------------------------------

enum AccountGroup {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model ChartOfAccount {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  code        String // e.g. "1000", "2000"
  name        String
  group       AccountGroup
  subGroup    String?      @map("sub_group") // Cash, Bank, AR, AP, etc.
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([businessId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  entryNumber String   @map("entry_number")
  date        DateTime
  narration   String
  reference   String? // Document No or Invoice ID
  isPosted    Boolean  @default(true) @map("is_posted")
  createdAt   DateTime @default(now()) @map("created_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines            JournalLine[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]

  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)
  notes          String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

// ----------------------------------------------------
// 7. Sales, Purchases, Payments & Expenses
// ----------------------------------------------------

enum InvoiceType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  NON_GST
  PROFORMA
  QUOTATION
  ESTIMATE
  SALES_ORDER
  DELIVERY_CHALLAN
  CREDIT_NOTE
  DEBIT_NOTE
  SALES_RETURN
  RECURRING_INVOICE
  POS_RECEIPT
}

enum InvoiceStatus {
  DRAFT
  POSTED
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model SalesInvoice {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  relatedInvoiceId String?     @map("related_invoice_id") @db.Uuid
  invoiceType    InvoiceType   @default(TAX_INVOICE) @map("invoice_type")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  invoiceNumber  String        @map("invoice_number")
  invoiceDate    DateTime      @map("invoice_date")
  dueDate        DateTime      @map("due_date")
  status         InvoiceStatus @default(POSTED)
  taxableAmount  Decimal       @default(0) @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount     Decimal       @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount     Decimal       @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount     Decimal       @default(0) @map("igst_amount") @db.Decimal(15, 2)
  totalTax       Decimal       @default(0) @map("total_tax") @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)
  additionalCharges Decimal    @default(0) @map("additional_charges") @db.Decimal(15, 2)
  pricesIncludeTax Boolean     @default(false) @map("prices_include_tax")
  roundOff       Decimal       @default(0) @map("round_off") @db.Decimal(15, 2)
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  notes          String?
  terms          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  relatedInvoice SalesInvoice?     @relation("SalesInvoiceAdjustments", fields: [relatedInvoiceId], references: [id])
  adjustments SalesInvoice[]       @relation("SalesInvoiceAdjustments")
  items        SalesInvoiceItem[]
  allocations  PaymentAllocation[]

  @@index([relatedInvoiceId])
  @@unique([branchId, invoiceNumber])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  salesInvoiceId String  @map("sales_invoice_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  description    String?
  unitName       String?  @map("unit_name")
  quantity       Decimal @db.Decimal(15, 2)
  unitPrice      Decimal @map("unit_price") @db.Decimal(15, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxableValue   Decimal @map("taxable_value") @db.Decimal(15, 2)
  gstRate        Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(15, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(15, 2)

  salesInvoice SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sales_invoice_items")
}

model PurchaseInvoice {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  supplierId     String        @map("supplier_id") @db.Uuid
  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  billNumber     String        @map("bill_number")
  billDate       DateTime      @map("bill_date")
  dueDate        DateTime      @map("due_date")
  status         InvoiceStatus @default(POSTED)
  taxableAmount  Decimal       @default(0) @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount     Decimal       @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount     Decimal       @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount     Decimal       @default(0) @map("igst_amount") @db.Decimal(15, 2)
  totalTax       Decimal       @default(0) @map("total_tax") @db.Decimal(15, 2)
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  journalEntry JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  items        PurchaseInvoiceItem[]
  allocations  PaymentAllocation[]

  @@unique([branchId, billNumber])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purchaseInvoiceId String  @map("purchase_invoice_id") @db.Uuid
  variantId         String  @map("variant_id") @db.Uuid
  quantity          Decimal @db.Decimal(15, 2)
  unitPrice         Decimal @map("unit_price") @db.Decimal(15, 2)
  taxableValue      Decimal @map("taxable_value") @db.Decimal(15, 2)
  gstRate           Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount        Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount        Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount        Decimal @default(0) @map("igst_amount") @db.Decimal(15, 2)
  totalAmount       Decimal @map("total_amount") @db.Decimal(15, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  variant         ProductVariant  @relation(fields: [variantId], references: [id])

  @@map("purchase_invoice_items")
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_DISBURSEMENT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  CREDIT
}

model Payment {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  type        PaymentType
  customerId  String?     @map("customer_id") @db.Uuid
  supplierId  String?     @map("supplier_id") @db.Uuid
  mode        PaymentMode @default(CASH)
  amount      Decimal     @db.Decimal(15, 2)
  paymentDate DateTime    @map("payment_date")
  reference   String?
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer?           @relation(fields: [customerId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId         String  @map("payment_id") @db.Uuid
  salesInvoiceId    String? @map("sales_invoice_id") @db.Uuid
  purchaseInvoiceId String? @map("purchase_invoice_id") @db.Uuid
  amount            Decimal @db.Decimal(15, 2)

  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@map("payment_allocations")
}

model Expense {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  category    String // Rent, Salary, Electricity, Fuel, etc.
  amount      Decimal     @db.Decimal(15, 2)
  expenseDate DateTime    @map("expense_date")
  paymentMode PaymentMode @default(CASH) @map("payment_mode")
  gstin       String?
  taxAmount   Decimal     @default(0) @map("tax_amount") @db.Decimal(15, 2)
  receiptUrl  String?     @map("receipt_url")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

// ----------------------------------------------------
// 8. System Audit Logs
// ----------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  businessId String?  @map("business_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // CREATE, UPDATE, DELETE, CANCEL, POST
  entityType String   @map("entity_type") // SalesInvoice, User, etc.
  entityId   String   @map("entity_id") @db.Uuid
  diff       Json? // before and after state
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
