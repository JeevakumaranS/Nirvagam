{
  "name": "nirvagam",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@nirvagam/shared",
    "dev:backend": "npm run build:shared && npm run start:dev --workspace=@nirvagam/backend",
    "dev:frontend": "npm run build:shared && npm run dev --workspace=@nirvagam/frontend",
    "dev": "npm run build:shared && concurrently \"npm run start:dev --workspace=@nirvagam/backend\" \"npm run dev --workspace=@nirvagam/frontend\"",
    "build:backend": "npm run build --workspace=@nirvagam/backend",
    "build:frontend": "npm run build --workspace=@nirvagam/frontend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@nirvagam/backend",
    "prisma:push": "npm run prisma:push --workspace=@nirvagam/backend",
    "prisma:uuidv7": "npm run prisma:uuidv7 --workspace=@nirvagam/backend",
    "prisma:seed": "npm run prisma:seed --workspace=@nirvagam/backend",
    "tenant:provision": "npm run tenant:provision --workspace=@nirvagam/backend --",
    "tenant:migrate": "npm run tenant:migrate --workspace=@nirvagam/backend --",
    "super-admin:create": "npm run super-admin:create --workspace=@nirvagam/backend --"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.3.1",
    "@prisma/client": "^5.14.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.24",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
